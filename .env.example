# Postgres in Docker Compose; SQLite works for local dev and tests.
DATABASE_URL=sqlite:///./backlot.db
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOG_LEVEL=INFO
SYNTHETIC_SEED=42
RISK_MODEL_PATH=models/risk_model.joblib
# Optional: enable the LLM report / real vision adapter (never commit real keys)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
VISION_MODEL=claude-sonnet-5-5
VISION_ADAPTER=none        # none | simulated | anthropic
REDIS_URL=
